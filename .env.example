# Copy to .env and adjust. Every setting is optional except a listing source.

# --- Listing sources ---
# Either list search URLs here (space separated; placeholders {town_slug}, {town}, {district}, {page}),
# or describe sites in config/sources.toml (see config/sources.example.toml). Check each site's terms first.
SOURCE_URLS=
# SOURCES_FILE=config/sources.toml
# PLUGINS_DIR=plugins
# Optional browser view (port 6080) for job plugins that need a person; VNC uses the first 8 characters.
VNC_PASSWORD=
BROWSER_VIEW_URL=

# When to scrape (cron, Europe/Budapest time). Default: every day at 06:00.
SCHEDULE=0 6 * * *
# When to re-check train times and night trains. Default: 04:00 on the 1st of each month.
TRANSIT_SCHEDULE=0 4 1 * *

# Which areas to scrape: commuter towns, Budapest + agglomeration, or both.
AREAS=commuter,budapest
# Weekly rebuild of the Budapest public-transport grid (BKK and Volánbusz publish new timetables weekly).
GRID_SCHEDULE=0 2 * * 1
# Optional: MÁV's official GTFS (free, needs registration at mavcsoport.hu/gtfs-igenybejelento).
# Without it, Budapest travel times use BKK and Volánbusz only (no MÁV trains).
MAV_GTFS_URL=
# Opt-in: query MÁV's public journey planner for train times instead (unofficial, no published API terms).
MAV_PLANNER=0

# Push notifications (new ads, checks waiting for you), e.g. https://ntfy.sh/<long-random-topic>
NOTIFY_URL=
# If set, the dashboard's "Run now" buttons need this token.
DASHBOARD_TOKEN=

# Detail pages (sources with details = true): how many to open per run.
MAX_DETAILS_PER_RUN=400

# Optional: let Claude read ad texts to find streets, landmarks and "near the station" mentions
# for houses whose portal hides the exact location. Leave empty to skip this step.
ANTHROPIC_API_KEY=
# Model and effort for that step. claude-haiku-5-5 is far cheaper if cost matters.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
# Upper limit of ads sent to Claude per run (the first run has the most).
CLAUDE_MAX_PER_RUN=400

# Your e-mail: sent in the User-Agent so site owners can reach you, and to the OpenStreetMap geocoder (recommended).
CONTACT_EMAIL=

# Default seconds between requests to the same website (never below 1.5; robots.txt Crawl-delay wins if higher).
REQUEST_DELAY=3

# Limit to some sources or towns (comma separated), e.g. for testing.
# SOURCES=example
# TOWNS=Cegléd,Monor
